# Replace placeholders before starting the stack.
APP_ENV=local
APP_DEBUG=false
APP_KEY=base64:replace-with-a-generated-laravel-app-key
APP_URL=http://localhost:8080
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=replace-with-a-unique-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
HOST_PORT=8080
